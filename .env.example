# Copia este archivo a .env y completa los valores de tu proyecto Supabase.
# El servidor los inyecta en el index.html al arrancar.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Respaldo diario: horario cron (por defecto medianoche) y correo de envio.
# BACKUP_CRON acepta formato de 6 campos con segundos. Ej: cada minuto '*/30 * * * * *'.
BACKUP_CRON=0 0 0 * * *

# Envio del respaldo comprimido por Gmail (opcional; sin esto solo se guarda local).
# MAIL_PASS es la contrasena de aplicacion de Google (16 letras), no tu clave normal.
# El .env nunca se sube a git.
MAIL_USER=
MAIL_PASS=
MAIL_TO=
